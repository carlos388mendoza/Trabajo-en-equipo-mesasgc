# Copia este archivo a .env.local y llena los valores reales
# NUNCA subas el archivo .env.local a GitHub (ya está en .gitignore)

# --- Turso (base de datos) ---
# Salen de `turso db show <nombre>` o del panel web de Turso.
# Formato: libsql://<tu-usuario>.<tu-db>.turso.io
TURSO_DATABASE_URL=
# Solo hace falta en bases remotas. En local puede ir vacío.
TURSO_AUTH_TOKEN=

# --- Better Auth ---
# Obligatorio. Firma las cookies de sesión: sin él no se puede iniciar sesión.
# Genera uno con: openssl rand -base64 32   (distinto en cada entorno)
BETTER_AUTH_SECRET=
# En local: http://localhost:3000 — en Railway, la URL pública del servicio.
# Con https, la cookie de sesión se marca `Secure` automáticamente.
BETTER_AUTH_URL=http://localhost:3000

# --- Primer admin en producción (npm run create-admin) ---
# Opcionales: si no se ponen, el script los pregunta. No los dejes guardados
# en el servidor después de usarlos.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Servidor (Next + Socket.IO) ---
# `server.ts` sirve Next y Socket.IO en el MISMO puerto. Si no se pone, 3000.
# Railway lo inyecta solo en producción: no hace falta ponerlo allí.
# PORT=3000
# Opcional. Solo si el servidor de Socket.IO viviera en OTRO origen que la
# página. Vacío (lo normal), el navegador se conecta al mismo origen.
NEXT_PUBLIC_SOCKET_URL=

# --- OpenRouter (IA) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
