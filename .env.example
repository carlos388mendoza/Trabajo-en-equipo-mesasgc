# Copia este archivo a .env.local y llena los valores reales
# NUNCA subas el archivo .env.local a GitHub (ya está en .gitignore)

# --- Turso (base de datos) ---
# Salen de `turso db show <nombre>` o del panel web de Turso.
# Formato: libsql://<tu-usuario>.<tu-db>.turso.io
TURSO_DATABASE_URL=
# Solo hace falta en bases remotas. En local puede ir vacío.
TURSO_AUTH_TOKEN=

# --- Better Auth ---
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# En local: http://localhost:3000 — en Railway, la URL pública del servicio.
BETTER_AUTH_URL=http://localhost:3000

# --- Socket.IO (tiempo real) ---
# Puerto del servidor Node custom. Railway lo inyecta solo en producción;
# en local pon 3001 para no chocar con el de Next (3000).
PORT=3001
# URL pública del servidor de Socket.IO. En local apunta a Next con el mismo
# puerto (el servidor Express también sirve la UI de Socket.IO).
# En Railway: https://<tu-servicio>.up.railway.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- OpenRouter (IA) ---
OPENROUTER_API_KEY=
