# dependencies
/node_modules

# next.js
/.next/
# salida de la app que levanta `npm run verify:auth`
/.next-verify/
/.next-verify-*/
# salida de la app que levanta `npx tsx scripts/verify-browser.mts`
/.next-browser*/
/out/

# production
/build

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local de desarrollo (TURSO_DATABASE_URL=file:./local.db)
local.db
local.db-wal
local.db-shm

# bases de datos temporales de `npm run verify:editor`, `verify:realtime`,
# `verify:auth` y `verify:demo`
.verify-editor.db*
.verify-realtime.db*
.verify-auth.db*
.verify-demo.db*
.verify-browser.db*

# salida de `npx tsx scripts/verify-browser.mts` (capturas y resultado)
.verify-browser/

# logs de `next dev` en segundo plano
.dev-*.log

# configuración local de Claude Code (levantar la app desde el panel)
.claude/launch.json
